# Běhový stav dem — obsahuje živé tokeny přihlášených, do gitu nepatří.
# Cesta je ukotvená ke korenu repozitáře, takže se musí přepsat, kdykoli se
# demo přestěhuje.
examples/basic_demo/bff/data/*.json

# Tajný klíč pro podepisování session — vygeneruje se jednou do data/
# (auth.inc), tvrdě v gitu se neměl nikdy vyskytovat.
examples/basic_demo/bff/data/*.key

# Nastavení KONKRÉTNÍ instalace příkladu — hesla k databázi v čitelné
# podobě. Do gitu patří jen config.example.*, ze kterých je instalák dělá.
examples/library/api/config.inc
examples/library/bff/config.inc
examples/library/app/config.js

# Prohlížitelná dokumentace se generuje: php doc/build.php
doc/index.html

# Lokální seznam projektů, do kterých se framework rozváží.
tools/targets.local

# Zálohy editorů a naše vlastní
*.bak
*~
